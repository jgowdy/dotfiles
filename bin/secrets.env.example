# Template for ~/.config/secrets.env — copy to ~/.config/secrets.env, fill in,
# and `chmod 600`. This file is NOT tracked (it holds real tokens + all
# org-specific values). ~/.zshrc sources it before bin/aws_creds_sync.sh.

# ── Artifactory / Atlassian (examples; only if you use them) ──────────────────
# ARTIFACTORY_USERNAME=you@example.com
# ARTIFACTORY_TOKEN=...
# ATLASSIAN_API_KEY=...

# ── AWS via aws-okta-processor ────────────────────────────────────────────────
# Identity + naming vocabulary. Exported so gen-aws-profiles.py (a child
# process) sees them. The committed scripts contain NO org-specific values —
# everything organization-specific lives here. Without the three identity vars,
# aws_creds_sync.sh prints a hint and does nothing.
export AWS_OKTA_ORG=your-org.okta.com
export AWS_OKTA_USER=your-okta-username
export AWS_OKTA_APP=https://your-org.okta.com/home/amazon_aws/<app-id>/<id>
# Optional (defaults to token:hardware:yubico):
# export AWS_OKTA_FACTOR=token:hardware:yubico

# Alias-scheme vocabulary — set these to match YOUR IAM role naming. The values
# below are illustrative placeholders, not a real org's taxonomy. The FIRST
# entry in *_ACCOUNTTYPES / *_ROLES is the implied default, omitted from profile
# names (so e.g. `web` == web / <first-accounttype> / <first-role>; `web-ops`
# overrides the role; `web-prod-ops` overrides both). Multi-word account types
# like "dev-shared" are supported (matched before their single-word prefix).
export AWSPROF_ACCOUNTTYPES="sandbox dev test prod"
export AWSPROF_ROLES="admin poweruser readonly"
# Friendly service renames, space-separated "from=to" (from = the token in your
# role names; to = what you type). Optional.
export AWSPROF_SERVICE_ALIASES="longservicename=short"
# Default alias for `aws-refresh` with no argument. Optional.
export AWSPROF_DEFAULT_TARGET=web

# Optional overrides:
# export AWSPROF_DEFAULT_ACCOUNTTYPE=sandbox   # default: first of *_ACCOUNTTYPES
# export AWSPROF_DEFAULT_ROLE=admin             # default: first of *_ROLES
# export AWS_OKTA_ROLES_RAW=$HOME/.aws/aws-okta-roles.raw.txt
# export AWS_OKTA_ROLES_TSV=$HOME/.aws/aws-okta-roles.tsv
